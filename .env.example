# 复制本文件为 .env 并填入你的配置：
#   cp .env.example .env
# 之后直接运行 .venv/bin/python main.py 即可，无需每次 export。
#
# 注意：.env 含密钥，已被 .gitignore 忽略，切勿提交到仓库。

# 必填：你的 API 密钥（把下面的占位符换成你的真实 key）
MY_AGENT_API_KEY=你的key

# 可选：模型名（默认 gpt-4o-mini）
MY_AGENT_MODEL=deepseek-v4-flash:0731-cloud

# 可选：OpenAI 兼容端点（默认 https://api.openai.com/v1）
# 例如 DeepSeek: https://api.deepseek.com/v1
MY_AGENT_BASE_URL=https://ollama.com/v1

# 可选：安全 Guard 模式（默认 smart）
#   readonly - 只允许只读操作，其余拒绝
#   ask      - 风险操作询问用户确认
#   auto     - 自动放行（仍拦截结构性高危/危险命令/敏感文件）
#   smart    - 用 LLM 审查 exec 命令（推荐）
MY_AGENT_GUARD_MODE=smart

# 可选：Guard 审计日志路径（留空则不记录）
# 例如 guard_audit.log
MY_AGENT_GUARD_AUDIT=
