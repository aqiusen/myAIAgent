# 复制本文件为 .env 并填入你的配置：
#   cp .env.example .env
# 之后直接运行 .venv/bin/python main.py 即可，无需每次 export。
#
# 注意：.env 含密钥，已被 .gitignore 忽略，切勿提交到仓库。

# 必填：你的 API 密钥（把下面的占位符换成你的真实 key）
MY_AGENT_API_KEY=你的key

# 可选：模型名（默认 gpt-4o-mini）
MY_AGENT_MODEL=deepseek-v4-flash:0731-cloud

# 可选：OpenAI 兼容端点（默认 https://api.openai.com/v1）
# 例如 DeepSeek: https://api.deepseek.com/v1
MY_AGENT_BASE_URL=https://ollama.com/v1

# 可选：安全 Guard 模式（默认 smart）
#   readonly - 只允许只读操作，其余拒绝
#   ask      - 风险操作询问用户确认
#   auto     - 自动放行（仍拦截结构性高危/危险命令/敏感文件）
#   smart    - 用 LLM 审查 exec 命令（推荐）
MY_AGENT_GUARD_MODE=smart

# 可选：Guard 审计日志路径（留空则不记录）
# 例如 guard_audit.log
MY_AGENT_GUARD_AUDIT=

# 可选：上下文 token 预算（默认 8000），超过则裁剪旧消息
MY_AGENT_MAX_TOKENS=8000

# 可选：会话持久化 DB 路径（默认项目 db/myagent.db，重启后能接着聊）
# 留空则关闭持久化
MY_AGENT_DB_PATH=db/myagent.db

# 可选：额外模型（JSON 数组，支持多提供商切换）
# 主模型用上面的 MY_AGENT_MODEL/BASE_URL/API_KEY，额外模型写在这里：
# 支持多行 JSON（注意：不能有尾逗号，不能有注释）
# MY_AGENT_MODELS=[{
#   "ref": "vision",
#   "model": "gpt-4o",
#   "base_url": "https://api.openai.com/v1",
#   "api_key": "sk-xxx"
# }]
# 对话里用 /model 查看和切换模型

# 可选：MCP 服务器（JSON 数组，接入外部工具）
# 每个服务器：id（唯一标识）、command（启动命令）、args（参数）
# 例如接入文件系统 MCP 服务器：
# MY_AGENT_MCP_SERVERS=[{"id":"fs","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]
